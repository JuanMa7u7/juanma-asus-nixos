#!/usr/bin/env bash

# Caelestia Color Sync Script
# Reads Caelestia's scheme.json and generates colors for:
# - Kitty terminal
# - Hyprland window borders
# - Starship prompt
# Run this on shell startup to keep colors in sync with the active theme

set -e

CAELESTIA_STATE="${HOME}/.local/state/caelestia"
SCHEME_JSON="${CAELESTIA_STATE}/scheme.json"
KITTY_COLORS="${HOME}/.config/kitty/colours.conf"
HYPR_COLORS="${HOME}/.config/hypr/scheme/caelestia-colors.conf"
STARSHIP_CONFIG="${HOME}/.config/starship-dynamic.toml"

# Check if scheme.json exists
if [[ ! -f "$SCHEME_JSON" ]]; then
    echo "Caelestia scheme.json not found at $SCHEME_JSON" >&2
    exit 1
fi

# Function to get a color from scheme.json (returns hex with #)
get_color() {
    local key="$1"
    local color
    color=$(jq -r ".colours[\"$key\"] // empty" "$SCHEME_JSON" 2>/dev/null) || return 1
    if [[ -n "$color" ]]; then
        echo "#${color}"
    fi
}

# Function to get a color without # (for Hyprland)
get_color_hypr() {
    local key="$1"
    local color
    color=$(jq -r ".colours[\"$key\"] // empty" "$SCHEME_JSON" 2>/dev/null) || return 1
    if [[ -n "$color" ]]; then
        echo "${color}"
    fi
}

# Generate Kitty colors config
generate_kitty_colors() {
    local kitty_dir="${HOME}/.config/kitty"
    mkdir -p "$kitty_dir"
    
    {
        echo "# Caelestia Dynamic Colors - Generated by caelestia-colors.sh"
        echo "# Do not edit manually - colors sync from Caelestia theme"
        echo ""
        
        # Background & Foreground
        echo "background $(get_color "surface" || get_color "background" || echo "#1E1E24")"
        echo "foreground $(get_color "onSurface" || get_color "background" || echo "#F5F5F6")"
        
        # Selection
        echo "selection_background $(get_color "primary" || echo "#24BD5C")"
        echo "selection_foreground $(get_color "onPrimary" || echo "#091f11")"
        
        # Cursor
        echo "cursor $(get_color "primary" || echo "#24BD5C")"
        echo "cursor_text_color $(get_color "onPrimary" || echo "#091f11")"
        
        # URL color
        echo "url_color $(get_color "tertiary" || echo "#32653E")"
        
        # Tab bar colors
        echo "active_tab_foreground $(get_color "onPrimary" || get_color "onSurface" || echo "#091f11")"
        echo "active_tab_background $(get_color "primary" || echo "#24BD5C")"
        echo "inactive_tab_foreground $(get_color "onSurfaceVariant" || echo "#c9c9c9")"
        echo "inactive_tab_background $(get_color "surfaceVariant" || get_color "surface" || echo "#23262C")"
        
        # Terminal colors (term0-term15)
        local term_colors=("term0" "term1" "term2" "term3" "term4" "term5" "term6" "term7" "term8" "term9" "term10" "term11" "term12" "term13" "term14" "term15")
        for i in "${!term_colors[@]}"; do
            local color_idx=${term_colors[$i]}
            local color
            color=$(get_color "$color_idx" || echo "")
            if [[ -n "$color" ]]; then
                echo "color$i $color"
            fi
        done
        
    } > "$KITTY_COLORS" 2>/dev/null
}

# Generate Hyprland colors config
generate_hypr_colors() {
    local hypr_dir="${HOME}/.config/hypr/scheme"
    mkdir -p "$hypr_dir"
    
    {
        echo "# Caelestia Dynamic Colors - Generated by caelestia-colors.sh"
        echo "# Do not edit manually - colors sync from Caelestia theme"
        echo ""
        
        # Primary colors (for window borders)
        echo "\$primary = $(get_color_hypr "primary" || echo "24BD5C")"
        echo "\$onPrimary = $(get_color_hypr "onPrimary" || echo "091f11")"
        echo "\$primaryContainer = $(get_color_hypr "primaryContainer" || echo "232c29")"
        
        # Secondary
        echo "\$secondary = $(get_color_hypr "secondary" || echo "24BD5C")"
        echo "\$onSecondary = $(get_color_hypr "onSecondary" || echo "043a14")"
        
        # Surface colors
        echo "\$background = $(get_color_hypr "background" || echo "23262D")"
        echo "\$surface = $(get_color_hypr "surface" || echo "1E1E24")"
        echo "\$surfaceContainerHighest = $(get_color_hypr "surfaceContainerHighest" || echo "232C29")"
        echo "\$surfaceVariant = $(get_color_hypr "surfaceVariant" || echo "23262C")"
        echo "\$onSurface = $(get_color_hypr "onSurface" || echo "F5F5F6")"
        echo "\$onSurfaceVariant = $(get_color_hypr "onSurfaceVariant" || echo "c9c9c9")"
        
        # Border colors (with alpha)
        echo "\$borderActive = rgba($(get_color_hypr "primary" || echo "24BD5C")aa)"
        echo "\$borderInactive = rgba($(get_color_hypr "surfaceVariant" || echo "23262C")aa)"
        
    } > "$HYPR_COLORS" 2>/dev/null
}

# Generate Starship config
generate_starship_config() {
    local starship_dir="${HOME}/.config"
    mkdir -p "$starship_dir"
    
    # Get colors from Caelestia
    local primary on_surface surface surface_variant surface_highest background
    
    primary=$(get_color "primary" || echo "#24BD5C")
    on_surface=$(get_color "onSurface" || echo "#F5F5F6")
    surface=$(get_color "surface" || echo "#1E1E24")
    surface_variant=$(get_color "surfaceVariant" || echo "#23262C")
    surface_highest=$(get_color "surfaceContainerHighest" || echo "#232C29")
    background=$(get_color "background" || echo "#23262D")
    
    # Write starship config using printf for proper escaping
    {
        printf '# Caelestia Dynamic Starship Config - Generated by caelestia-colors.sh\n'
        printf '# Do not edit manually - colors sync from Caelestia theme\n\n'
        
        # Format - arrow segments with Caelestia colors (single line)
        local fmt_str
        fmt_str="[░▒▓](${primary})[ 🗿](bg:${primary} fg:${on_surface})"
        fmt_str+="\$directory[▓▒░](bg:${surface_variant} fg:${primary})"
        fmt_str+="\$git_branch\$git_status"
        fmt_str+="\$nodejs\$rust\$golang\$bun\$python\$php"
        # fmt_str+="[▓](fg:${surface} bg:${surface_variant})"
        fmt_str+="\$docker_context\$kubernetes\$nix_shell\$package"
        # fmt_str+="[▓](fg:${surface} bg:${surface_variant})"
        fmt_str+="\$time(fg:${background})"
        fmt_str+="[](fg:${background})\n\$character"
        
        printf 'format = """\n%s"""\n\n' "$fmt_str"
        
        # Directory module
        printf '[directory]\n'
        printf 'style = "fg:%s bg:%s"\n' "$on_surface" "$primary"
        printf 'format = "[ $path ]($style)"\n'
        printf 'truncation_length = 3\n'
        printf 'truncation_symbol = "…/"\n\n'
        
        printf '[directory.substitutions]\n'
        printf '"Documents" = "󰈙 "\n'
        printf '"Downloads" = " "\n'
        printf '"Music" = " "\n'
        printf '"Pictures" = " "\n\n'
        
        # Git branch
        printf '[git_branch]\n'
        printf 'symbol = ""\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[ $symbol $branch ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
        # Git status
        printf '[git_status]\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[($all_status$ahead_behind )](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
        # Language modules
        local lang_style="bg:$surface"
        
        printf '[nodejs]\n'
        printf 'symbol = ""\n'
        printf 'style = "bg:%s"\n' "$surface"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$surface"
        
        printf '[rust]\n'
        printf 'symbol = ""\n'
        printf 'style = "bg:%s"\n' "$surface"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$surface"
        
        printf '[golang]\n'
        printf 'symbol = ""\n'
        printf 'style = "bg:%s"\n' "$surface"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$surface"
        
        printf '[bun]\n'
        printf 'symbol = "󰀓"\n'
        printf 'style = "bg:%s"\n' "$surface"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$surface"
        
        printf '[python]\n'
        printf 'symbol = "󰌠"\n'
        printf 'style = "bg:%s"\n' "$surface"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$surface"
        
        printf '[php]\n'
        printf 'symbol = ""\n'
        printf 'style = "bg:%s"\n' "$surface"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$surface"
        
        # DevOps/Tools
        printf '[docker_context]\n'
        printf 'symbol = "󰡨"\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
        printf '[kubernetes]\n'
        printf 'symbol = "󰠱"\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
        printf '[nix_shell]\n'
        printf 'symbol = ""\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[ $symbol ($name) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
        printf '[package]\n'
        printf 'symbol = "󰏖"\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[ $symbol ($version) ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
        # Time
        printf '[time]\n'
        printf 'disabled = false\n'
        printf 'time_format = "%%R"\n'
        printf 'style = "bg:%s"\n' "$background"
        printf 'format = '"'"'[[  $time ](fg:%s bg:%s)]($style)'"'"'\n\n' "$primary" "$background"
        
    } > "$STARSHIP_CONFIG" 2>/dev/null
}

# Main execution
generate_kitty_colors
generate_hypr_colors
generate_starship_config

# Notify Kitty to reload colors if it's running
if pgrep -x "kitty" > /dev/null 2>&1; then
    kitty @ set-colors --all "$KITTY_COLORS" 2>/dev/null || true
fi

# Output eval-friendly exports for Starship
primary=$(get_color "primary" || echo "#24BD5C")
on_surface=$(get_color "onSurface" || echo "#F5F5F6")
echo "export STARSHIP_ACCENT=\"$primary\""
echo "export STARSHIP_FOREGROUND=\"$on_surface\""
echo "export STARSHIP_CONFIG=\"$STARSHIP_CONFIG\""
